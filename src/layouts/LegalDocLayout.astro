---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  pageTitle: string;
  badgeText?: string;
  siblingHref: string;
  siblingLabel: string;
}

const {
  title,
  description,
  canonicalUrl,
  pageTitle,
  badgeText = 'Meta Quest XR',
  siblingHref,
  siblingLabel
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0c0f17" />
    <style is:global>
      :root {
        --legal-bg: #0c0f17;
        --legal-card: #141926;
        --legal-text-primary: #e2e8f0;
        --legal-text-secondary: #94a3b8;
        --legal-accent: #38bdf8;
        --legal-accent-glow: rgba(56, 189, 248, 0.12);
        --legal-border: #1e293b;
        --legal-code-bg: #1e293b;
        --legal-warning-bg: rgba(245, 158, 11, 0.12);
        --legal-warning-border: #f59e0b;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.75;
        background-color: var(--legal-bg);
        color: var(--legal-text-primary);
        margin: 0;
        padding: 24px;
      }

      .legal-container {
        max-width: 860px;
        margin: 0 auto;
        background: var(--legal-card);
        padding: 40px;
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
        border: 1px solid var(--legal-border);
      }

      .legal-header-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px 16px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--legal-border);
      }

      .legal-nav-right {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      .legal-back-link {
        color: var(--legal-accent);
        text-decoration: none;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .legal-back-link:hover {
        text-decoration: underline;
      }

      .legal-container h1 {
        color: #ffffff;
        font-size: 2.05rem;
        line-height: 1.25;
        margin-top: 0;
        margin-bottom: 8px;
        border-bottom: 2px solid var(--legal-accent);
        padding-bottom: 12px;
      }

      .legal-container h2 {
        color: var(--legal-accent);
        font-size: 1.32rem;
        margin-top: 34px;
        margin-bottom: 12px;
      }

      .legal-container h3 {
        color: #f1f5f9;
        font-size: 1.08rem;
        margin-top: 20px;
        margin-bottom: 8px;
      }

      .legal-container p,
      .legal-container li {
        color: var(--legal-text-secondary);
        font-size: 1.01rem;
      }

      .legal-container strong {
        color: var(--legal-text-primary);
      }

      .legal-container ul,
      .legal-container ol {
        padding-left: 24px;
      }

      .legal-container li {
        margin-bottom: 10px;
      }

      .legal-container a {
        color: var(--legal-accent);
        text-decoration: none;
      }

      .legal-container a:hover {
        text-decoration: underline;
      }

      .legal-container code {
        background: var(--legal-code-bg);
        color: #7dd3fc;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        word-break: break-word;
      }

      .meta-box {
        background: var(--legal-accent-glow);
        border-left: 4px solid var(--legal-accent);
        padding: 16px 20px;
        border-radius: 6px;
        margin: 24px 0 30px 0;
      }

      .meta-box p {
        margin: 6px 0;
        color: var(--legal-text-primary);
        font-size: 0.95rem;
      }

      .legal-badge {
        display: inline-block;
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
        padding: 2px 10px;
        border-radius: 9999px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-left: 8px;
        vertical-align: middle;
      }

      .highlight-box {
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid var(--legal-border);
        padding: 16px 20px;
        border-radius: 8px;
        margin: 18px 0;
      }

      .highlight-box p {
        margin: 0;
        color: var(--legal-text-primary);
      }

      .disclaimer-box {
        background: var(--legal-warning-bg);
        border-left: 4px solid var(--legal-warning-border);
        padding: 16px 20px;
        border-radius: 6px;
        margin: 22px 0;
      }

      .disclaimer-box p {
        margin: 0;
        color: #fde68a;
        font-size: 0.98rem;
      }

      .legal-footer {
        margin-top: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--legal-border);
        font-size: 0.9rem;
        color: var(--legal-text-secondary);
        text-align: center;
      }

      @media (max-width: 640px) {
        body {
          padding: 12px;
        }
        .legal-container {
          padding: 24px 18px;
        }
        .legal-container h1 {
          font-size: 1.65rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="legal-container">
      <nav class="legal-header-nav" aria-label="Document navigation">
        <a href="/" class="legal-back-link">&larr; Back to DevPhoton Portfolio</a>
        <div class="legal-nav-right">
          <a href={siblingHref} class="legal-back-link">{siblingLabel}</a>
          <a href="/privacy" class="legal-back-link">Privacy Hub &rarr;</a>
        </div>
      </nav>

      <h1>{pageTitle} <span class="legal-badge">{badgeText}</span></h1>
      <slot />

      <footer class="legal-footer">
        &copy; 2026 Gaurav Deore (DevPhoton). All rights reserved.
      </footer>
    </main>
  </body>
</html>

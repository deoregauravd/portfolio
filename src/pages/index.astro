---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CollapsibleSection from '../components/CollapsibleSection.astro';
import Showreel from '../components/Showreel.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import TechDashboard from '../components/TechDashboard.astro';
import PlatformMatrix from '../components/PlatformMatrix.astro';
import Skills from '../components/Skills.astro';
import EducationCertifications from '../components/EducationCertifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main-content">
    <Hero />

    <!-- Executive Directory Controls Bar -->
    <div class="container master-controls-container">
      <div class="master-accordion-controls glass-card">
        <div class="controls-status">
          <span class="status-indicator-dot"></span>
          <span class="status-text">Executive Summary View — All Sections Collapsed by Default</span>
        </div>
        <div class="controls-actions">
          <button id="master-collapse-all" class="btn-ctrl" type="button" aria-label="Collapse all sections">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
            <span>Collapse All</span>
          </button>
          <button id="master-expand-all" class="btn-ctrl" type="button" aria-label="Expand all sections">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span>Expand All</span>
          </button>
        </div>
      </div>
    </div>

    <!-- All Collapsible Section Panels Stacked Closely -->
    <div class="collapsible-sections-group">
      <!-- Section 1: SOLAR SYSTEM -->
      <CollapsibleSection
        id="showreel"
        icon="🪐"
        eyebrow="Interactive Simulation"
        title="SOLAR SYSTEM"
        defaultExpanded={false}
      >
        <Showreel />
      </CollapsibleSection>

      <!-- Section 2: PROJECTS -->
      <CollapsibleSection
        id="projects"
        icon="🚀"
        eyebrow="Production Portfolio"
        title="PROJECTS"
        badge="11 Shipped Works"
        defaultExpanded={false}
      >
        <Projects />
      </CollapsibleSection>

      <!-- Section 3: EXPERIENCE -->
      <CollapsibleSection
        id="experience"
        icon="💼"
        eyebrow="Career Progression"
        title="EXPERIENCE"
        badge="5 Years • 5 Firms"
        defaultExpanded={false}
      >
        <Experience />
      </CollapsibleSection>

      <!-- Section 4: LANGUAGES -->
      <CollapsibleSection
        id="tech-stack"
        icon="⚡"
        eyebrow="Interactive Analytics"
        title="LANGUAGES"
        badge="C# • Python • C++ • Java"
        defaultExpanded={false}
      >
        <TechDashboard />
      </CollapsibleSection>

      <!-- Section 5: PLATFORMS -->
      <CollapsibleSection
        id="platforms"
        icon="🎮"
        eyebrow="Cross-Platform Delivery"
        title="PLATFORMS"
        badge="9 Shipped Targets"
        defaultExpanded={false}
      >
        <PlatformMatrix />
      </CollapsibleSection>

      <!-- Section 6: TOOLS -->
      <CollapsibleSection
        id="skills"
        icon="🛠️"
        eyebrow="Engine Toolkits & Education"
        title="TOOLS"
        badge="Certified Unity & Spatial Tech"
        defaultExpanded={false}
      >
        <Skills />
        <div class="credentials-divider-wrap">
          <EducationCertifications />
        </div>
      </CollapsibleSection>

      <!-- Section 7: CONTACT -->
      <CollapsibleSection
        id="contact"
        icon="📬"
        eyebrow="Direct Inquiries"
        title="CONTACT"
        badge="Open to Roles"
        defaultExpanded={false}
      >
        <Contact />
      </CollapsibleSection>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .collapsible-sections-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 2rem;
  }

  .master-controls-container {
    padding-top: 0.5rem;
    padding-bottom: 0.15rem;
  }

  .master-accordion-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .controls-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 8px var(--accent-blue);
    display: inline-block;
  }

  .controls-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-ctrl:hover {
    color: var(--accent-blue);
    border-color: var(--border-focus);
    background: var(--bg-card);
    transform: translateY(-1px);
  }

  #master-expand-all {
    background: linear-gradient(135deg, #1a73e8 0%, #7c3aed 55%, #d96570 100%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 16px rgba(26, 115, 232, 0.42), 0 0 14px rgba(124, 58, 237, 0.35);
    padding: 0.42rem 1.05rem;
    font-size: 0.8rem;
    font-weight: 800;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  #master-expand-all:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 6px 22px rgba(26, 115, 232, 0.6), 0 0 20px rgba(124, 58, 237, 0.5);
    border-color: #ffffff;
    color: #ffffff;
  }

  .credentials-divider-wrap {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-subtle);
  }

  @media (max-width: 640px) {
    .master-accordion-controls {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  function setupAccordionInteractivity() {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.collapsible-section'));
    const expandAllBtn = document.getElementById('master-expand-all');
    const collapseAllBtn = document.getElementById('master-collapse-all');

    function toggleSection(sec: HTMLElement, shouldExpand?: boolean) {
      const isCurrentlyExpanded = sec.classList.contains('expanded');
      const expand = shouldExpand !== undefined ? shouldExpand : !isCurrentlyExpanded;

      if (expand) {
        sec.classList.add('expanded');
      } else {
        sec.classList.remove('expanded');
      }

      const header = sec.querySelector<HTMLElement>('.section-accordion-header');
      if (header) {
        header.setAttribute('aria-expanded', expand ? 'true' : 'false');
      }

      const label = sec.querySelector<HTMLElement>('.toggle-label');
      if (label) {
        label.textContent = expand ? 'Collapse' : 'Expand';
      }

      // If tech-stack was expanded, resize Chart.js canvas to ensure crisp rendering
      if (expand && sec.id === 'tech-stack') {
        setTimeout(() => {
          window.dispatchEvent(new Event('resize'));
        }, 150);
      }
    }

    // Attach click and keydown handlers to each accordion header
    sections.forEach((sec) => {
      const header = sec.querySelector<HTMLElement>('.section-accordion-header');
      if (!header) return;

      header.addEventListener('click', (e) => {
        e.preventDefault();
        toggleSection(sec);
      });

      header.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleSection(sec);
        }
      });
    });

    // Master Expand All
    expandAllBtn?.addEventListener('click', () => {
      sections.forEach((sec) => toggleSection(sec, true));
    });

    // Master Collapse All
    collapseAllBtn?.addEventListener('click', () => {
      sections.forEach((sec) => toggleSection(sec, false));
    });

    // Deep link auto-expansion for Navbar & Hero buttons
    function handleAnchorLink(targetId: string) {
      if (!targetId) return;
      const cleanId = targetId.replace('#', '');
      const targetSec = document.getElementById(cleanId);
      if (targetSec && targetSec.classList.contains('collapsible-section')) {
        toggleSection(targetSec, true);
        setTimeout(() => {
          targetSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.length > 1) {
          const targetSec = document.querySelector<HTMLElement>(href);
          if (targetSec && targetSec.classList.contains('collapsible-section')) {
            toggleSection(targetSec, true);
          }
        }
      });
    });

    // Check on initial page load if URL has a hash
    if (window.location.hash) {
      handleAnchorLink(window.location.hash);
    }
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAccordionInteractivity);
  } else {
    setupAccordionInteractivity();
  }
  document.addEventListener('astro:page-load', setupAccordionInteractivity);
</script>

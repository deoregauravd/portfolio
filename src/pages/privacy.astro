---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolio';
import { appsPrivacyList } from '../data/appsPrivacy';

const publisherName = portfolioData.personal.name || "Gaurav Deore";
const publisherBrand = "DevPhoton";
const email = portfolioData.personal.email || "support@devphoton.com";
---

<BaseLayout
  title={`Privacy Policies & Compliance Hub | ${publisherBrand}`}
  description={`Official Privacy Policies and regulatory compliance statements for applications developed and published by ${publisherName} (${publisherBrand}).`}
>
  <!-- Header -->
  <header class="hub-header">
    <div class="container hub-header-inner">
      <a href="/" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to DevPhoton</span>
      </a>

      <button id="theme-toggle-hub" class="theme-btn" aria-label="Toggle light and dark mode">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </header>

  <!-- Hub Main Content -->
  <main class="hub-main">
    <div class="container hub-container">
      <div class="hub-intro">
        <span class="hub-eyebrow">Legal & Compliance</span>
        <h1 class="hub-title">Application Privacy Policies</h1>
        <p class="hub-subtitle">
          Find official privacy statements, data handling practices, and store certification policies for all software published by <strong>{publisherName}</strong> under the <strong>{publisherBrand}</strong> umbrella.
        </p>
      </div>

      <!-- App Privacy Directory Cards -->
      <div class="app-cards-grid">
        {appsPrivacyList.map((app) => (
          <div class="app-card">
            <div class="app-card-top">
              <div class="store-badges">
                {app.stores.map((store) => (
                  <span class="store-tag">{store}</span>
                ))}
                <span class="platform-tag">{app.platform}</span>
              </div>
              <h2 class="app-card-title">{app.name}</h2>
              <p class="app-category">{app.category}</p>
            </div>

            <p class="app-card-summary">{app.summary}</p>

            <div class="app-card-meta">
              <div class="meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-emerald)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>Zero personal data collected</span>
              </div>
              <div class="meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>Updated: {app.lastUpdated}</span>
              </div>
            </div>

            <div class="app-card-action">
              <a href={`/${app.id}/privacy`} class="btn-view-policy">
                <span>View {app.name} Policy</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- General Publisher Privacy Commitment -->
      <section class="general-policy-card">
        <h2>DevPhoton General Privacy Principles</h2>
        <p>
          At DevPhoton, we believe that software should be delightful, high-performing, and privacy-respecting. Across our interactive 3D desktop software, games, and simulation tools:
        </p>
        <ul class="principles-list">
          <li><strong>Zero Sneakiness:</strong> We do not secretly gather telemetry, keystrokes, contact lists, or location files.</li>
          <li><strong>Local Sovereignty:</strong> Preferences and configuration are saved strictly on the end-user's device.</li>
          <li><strong>No Monetization of Personal Data:</strong> We do not sell user data to brokers, advertising networks, or third-party analytical companies.</li>
        </ul>
        <p class="general-contact">
          For general publisher inquiries or developer correspondence, reach out via <a href={`mailto:${email}`}>{email}</a> or our <a href="/#contact">contact section</a>.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const themeBtn = document.getElementById('theme-toggle-hub');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }
</script>

<style>
  .hub-header {
    height: var(--nav-height);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .hub-header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-blue);
    transform: translateX(-3px);
  }

  .theme-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
    transform: scale(1.05);
  }

  :global([data-theme="light"]) .icon-sun {
    display: none;
  }
  :global([data-theme="light"]) .icon-moon {
    display: block;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  .hub-main {
    padding: 3.5rem 0 5rem 0;
    min-height: calc(100vh - var(--nav-height));
  }

  .hub-container {
    max-width: 860px;
  }

  .hub-intro {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hub-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(26, 115, 232, 0.1);
    color: var(--accent-blue);
    border: 1px solid rgba(26, 115, 232, 0.2);
    margin-bottom: 1rem;
  }

  .hub-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .hub-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  .app-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .app-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .app-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-focus);
    box-shadow: var(--shadow-md);
  }

  .store-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .store-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: rgba(26, 115, 232, 0.1);
    color: var(--accent-blue);
    border: 1px solid rgba(26, 115, 232, 0.2);
  }

  .platform-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .app-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .app-category {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .app-card-summary {
    font-size: 0.975rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .app-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .btn-view-policy {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent-blue);
    color: #ffffff;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .btn-view-policy:hover {
    background: var(--accent-indigo);
    transform: translateX(4px);
    box-shadow: 0 4px 14px rgba(26, 115, 232, 0.35);
  }

  .general-policy-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
  }

  .general-policy-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .general-policy-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .principles-list {
    margin: 0 0 1.25rem 1.25rem;
    list-style-type: disc;
  }

  .principles-list li {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }

  .general-contact {
    margin-bottom: 0 !important;
    font-size: 0.9rem !important;
    color: var(--text-muted) !important;
  }

  .general-contact a {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .hub-title {
      font-size: 1.85rem;
    }
    .app-card {
      padding: 1.5rem;
    }
  }
</style>

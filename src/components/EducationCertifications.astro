---
import { portfolioData } from '../data/portfolio';

const { education, certifications } = portfolioData;
---

<div class="credentials-wrapper">
  <div class="credentials-grid">
      <!-- Certifications -->
      <div class="credentials-col">
        <div class="col-header">
          <span class="col-icon">📜</span>
          <h3 class="col-title">Certifications</h3>
        </div>

        <div class="cards-stack">
          {certifications.map((cert) => (
            <div class="credential-card glass-card">
              <div class="credential-top">
                <h4 class="credential-name">{cert.name}</h4>
                <span class="credential-date">{cert.date}</span>
              </div>
              <div class="credential-issuer-row">
                <span class="credential-issuer">{cert.issuer}</span>
                {cert.url && (
                  <a
                    href={cert.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cert-verify-link"
                    title="Verify Certificate"
                  >
                    <span>Verify Credential</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Education -->
      <div class="credentials-col">
        <div class="col-header">
          <span class="col-icon">🎓</span>
          <h3 class="col-title">Education</h3>
        </div>

        <div class="cards-stack">
          {education.map((edu) => (
            <div class="credential-card glass-card">
              <div class="credential-top">
                <h4 class="credential-name">{edu.degree}</h4>
                {edu.year && <span class="credential-date">{edu.year}</span>}
              </div>
              <div class="credential-institution">{edu.institution}</div>
              <div class="credential-location">{edu.location}</div>
              {edu.details && (
                <div class="credential-details">{edu.details}</div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

<style>
  .credentials-section {
    padding-top: 1rem;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .col-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .col-icon {
    font-size: 1.5rem;
  }

  .col-title {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .credential-card {
    padding: 1.35rem 1.5rem;
  }

  .credential-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .credential-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .credential-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    white-space: nowrap;
  }

  .credential-issuer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .credential-issuer, .credential-institution {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .cert-verify-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-cyan);
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.25);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 4px);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cert-verify-link:hover {
    background: rgba(6, 182, 212, 0.2);
    border-color: rgba(6, 182, 212, 0.5);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .credential-location {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .credential-details {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-emerald);
  }

  @media (max-width: 768px) {
    .credentials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { portfolioData } from '../data/portfolio';

const { experiences } = portfolioData;
---

<div class="experience-wrapper">
  <!-- Expand/Collapse Master Controls -->
  <div class="exp-controls-bar">
    <button id="toggle-all-exp-btn" class="toggle-all-btn" type="button" aria-expanded="false">
      <span class="toggle-all-icon">▸</span>
      <span class="toggle-all-text">Expand All Roles</span>
    </button>
  </div>

    <div class="timeline">
      {experiences.map((exp, index) => (
        <div class="timeline-item">
          <div class="timeline-marker">
            <div class="marker-dot"></div>
            {index < experiences.length - 1 && <div class="marker-line"></div>}
          </div>

          <div class="timeline-content glass-card exp-card" data-index={index}>
            <!-- Interactive Header Row -->
            <div
              class="exp-header"
              role="button"
              tabindex="0"
              aria-expanded="false"
              aria-controls={`exp-details-${index}`}
            >
              <div class="exp-header-left">
                <h3 class="exp-role">{exp.role}</h3>
                <div class="exp-company-row">
                  <span class="exp-company">{exp.company}</span>
                  <span class="exp-separator">•</span>
                  <span class="exp-location">{exp.location}</span>
                </div>
              </div>

              <div class="exp-header-right">
                <span class="exp-period">{exp.period}</span>
                <span class="exp-toggle-pill">
                  <span class="toggle-text">Details</span>
                  <svg class="chevron-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </div>
            </div>

            <!-- Smooth Collapsible Container -->
            <div id={`exp-details-${index}`} class="exp-collapsible-wrapper">
              <div class="exp-collapsible-inner">
                <ul class="exp-list">
                  {exp.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                {exp.sampleLink && (
                  <div class="exp-link-box">
                    <a
                      href={exp.sampleLink.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="sample-work-link"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                      </svg>
                      <span>{exp.sampleLink.label}</span>
                      <span class="arrow-icon">↗</span>
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

<style>
  .experience-section {
    padding: 3.5rem 0 4.5rem 0;
  }

  .exp-controls-bar {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .toggle-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    color: var(--accent-blue);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .toggle-all-btn:hover {
    border-color: var(--border-focus);
    background: var(--bg-tertiary);
    transform: translateY(-1px);
  }

  .toggle-all-icon {
    font-size: 0.85rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .timeline {
    position: relative;
    max-width: 860px;
    margin: 2.25rem auto 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .marker-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 3px solid var(--accent-blue);
    box-shadow: 0 0 12px rgba(26, 115, 232, 0.4);
    z-index: 2;
    margin-top: 1.25rem;
    flex-shrink: 0;
  }

  .marker-line {
    width: 2px;
    flex-grow: 1;
    background: linear-gradient(180deg, var(--accent-blue), rgba(155, 114, 203, 0.15));
    margin-top: 0.5rem;
  }

  .timeline-content {
    padding: 1.35rem 1.75rem;
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .timeline-content:hover {
    border-color: var(--border-focus);
  }

  .timeline-content.expanded {
    border-color: var(--border-focus);
    box-shadow: var(--shadow-md);
  }

  /* Header Row: Clickable Accordion */
  .exp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    user-select: none;
    outline: none;
  }

  .exp-header:focus-visible {
    outline: 2px solid var(--accent-blue);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .exp-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .exp-role {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .exp-company-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .exp-company {
    font-weight: 600;
    color: var(--accent-blue);
  }

  .exp-separator {
    color: var(--text-muted);
  }

  .exp-location {
    color: var(--text-muted);
  }

  .exp-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--badge-border);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .exp-toggle-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .exp-header:hover .exp-toggle-pill {
    color: var(--accent-blue);
    border-color: var(--border-focus);
    background: var(--bg-secondary);
  }

  .chevron-svg {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-content.expanded .chevron-svg {
    transform: rotate(180deg);
  }

  .timeline-content.expanded .exp-toggle-pill {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
  }

  /* GPU-Accelerated Smooth Grid Expand/Collapse */
  .exp-collapsible-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, margin-top 0.28s ease, padding-top 0.28s ease;
    opacity: 0;
    margin-top: 0;
    padding-top: 0;
  }

  .timeline-content.expanded .exp-collapsible-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border-subtle);
  }

  .exp-collapsible-inner {
    overflow: hidden;
  }

  .exp-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .exp-list li {
    position: relative;
    padding-left: 1.4rem;
  }

  .exp-list li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-gemini);
    font-size: 1rem;
    line-height: 1.4;
  }

  .exp-link-box {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .sample-work-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    transition: all var(--transition-fast);
  }

  .sample-work-link:hover {
    color: var(--accent-indigo);
    transform: translateX(3px);
  }

  .arrow-icon {
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .timeline-item {
      grid-template-columns: 28px 1fr;
      gap: 1rem;
    }

    .marker-dot {
      width: 14px;
      height: 14px;
      border-width: 2px;
      margin-top: 1.25rem;
    }

    .timeline-content {
      padding: 1.15rem 1.25rem;
    }

    .exp-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .exp-header-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  const expHeaders = document.querySelectorAll<HTMLElement>('.exp-header');
  const toggleAllBtn = document.getElementById('toggle-all-exp-btn');
  let allExpanded = false;

  expHeaders.forEach((header) => {
    const card = header.closest('.exp-card');
    
    // Click toggle
    header.addEventListener('click', () => {
      if (!card) return;
      const isExpanded = card.classList.contains('expanded');
      if (isExpanded) {
        card.classList.remove('expanded');
        header.setAttribute('aria-expanded', 'false');
      } else {
        card.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      }
    });

    // Keyboard Accessibility (Enter / Space)
    header.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        header.click();
      }
    });
  });

  // Master Expand / Collapse All
  toggleAllBtn?.addEventListener('click', () => {
    allExpanded = !allExpanded;
    toggleAllBtn.setAttribute('aria-expanded', String(allExpanded));

    const icon = toggleAllBtn.querySelector('.toggle-all-icon');
    const text = toggleAllBtn.querySelector('.toggle-all-text');

    if (icon && text) {
      if (allExpanded) {
        icon.textContent = '▾';
        text.textContent = 'Collapse All Experiences';
      } else {
        icon.textContent = '▸';
        text.textContent = 'Expand All Experiences';
      }
    }

    expHeaders.forEach((header) => {
      const card = header.closest('.exp-card');
      if (!card) return;

      if (allExpanded) {
        card.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      } else {
        card.classList.remove('expanded');
        header.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

---
import { portfolioData } from '../data/portfolio';

const { personal, socials } = portfolioData;
---

<section id="contact" class="section">
  <div class="container">
    <div class="contact-box glass-card">
      <div class="contact-content">
        <span class="section-eyebrow">Get In Touch</span>
        <h2 class="contact-title">Let's Build Something <span class="gradient-text">Exceptional</span></h2>
        <p class="contact-desc">
          Whether you have an XR simulation project, a game title in need of architecture & performance optimization, or an engineering role — my inbox is always open.
        </p>

        {personal.email ? (
          <!-- Quick Copy Email Row -->
          <div class="email-action-card">
            <div class="email-details">
              <span class="email-sub">Direct Email</span>
              <span class="email-address">{personal.email}</span>
            </div>

            <div class="email-buttons">
              <button id="copy-email-btn" class="btn btn-secondary" data-email={personal.email} aria-label="Copy email address">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Copy Email</span>
              </button>

              <a href={`mailto:${personal.email}`} class="btn btn-primary">
                <span>Send Message</span>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </a>
            </div>
          </div>
        ) : (
          <!-- Direct Connect Options when Email is Private -->
          <div class="email-action-card">
            <div class="email-details">
              <span class="email-sub">Direct Inquiries</span>
              <span class="email-address">Reach out on LinkedIn or GitHub</span>
            </div>

            <div class="email-buttons">
              {socials.linkedin && (
                <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                  <span>Message on LinkedIn</span>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/>
                  </svg>
                </a>
              )}
              {socials.github && (
                <a href={socials.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                  <span>View GitHub</span>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Contact Badges -->
        <div class="contact-meta">
          <div class="meta-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{personal.location}</span>
          </div>
          {personal.phone && (
            <div class="meta-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{personal.phone}</span>
            </div>
          )}
          {socials.resumeGoogleDocs && (
            <div class="meta-item">
              <a
                href={socials.resumeGoogleDocs}
                target="_blank"
                rel="noopener noreferrer"
                class="resume-direct-link"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>Live Google Docs Resume ↗</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-box {
    padding: 3.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg), 0 0 35px -5px rgba(26, 115, 232, 0.12);
    text-align: center;
  }

  .contact-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .contact-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .email-action-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.75rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 2.25rem;
    text-align: left;
  }

  .email-details {
    display: flex;
    flex-direction: column;
  }

  .email-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .email-address {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .email-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .contact-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .resume-direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-indigo);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .resume-direct-link:hover {
    color: var(--accent-cyan);
  }

  @media (max-width: 768px) {
    .contact-box {
      padding: 2.25rem 1.5rem;
    }
    .email-action-card {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .email-buttons {
      flex-direction: column;
    }
    .contact-meta {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script>
  // Copy email to clipboard
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
      if ((window as any).showToast) {
        (window as any).showToast('Email copied to clipboard!');
      }
    } catch (err) {
      console.error('Failed to copy email:', err);
    }
  });
</script>

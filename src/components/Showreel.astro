---
import { portfolioData } from '../data/portfolio';

const showreel = portfolioData.featuredShowreel;

// Helper to extract YouTube embed URL from various YouTube formats
function getEmbedUrl(url: string): string | null {
  if (!url) return null;
  const ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  if (ytMatch && ytMatch[1]) {
    const videoId = ytMatch[1];
    return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1&rel=0&loop=1&playlist=${videoId}&enablejsapi=1`;
  }
  return null;
}

const isYouTube = showreel?.videoUrl ? getEmbedUrl(showreel.videoUrl) : null;
const isDirectVideo = showreel?.videoUrl && !isYouTube;
---

{showreel && showreel.enabled && showreel.videoUrl && (
  <section id="showreel" class="section showreel-section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">🎬 Demo Reel</span>
        <h2 class="section-title">{showreel.title}</h2>
        <p class="section-subtitle">{showreel.subtitle}</p>
      </div>

      <div class="video-wrapper glass-card">
        {isYouTube ? (
          <div class="iframe-container">
            <iframe
              src={isYouTube}
              title={showreel.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="eager"
            ></iframe>
          </div>
        ) : isDirectVideo ? (
          <div class="video-player-container">
            <video controls autoplay muted loop playsinline preload="auto" class="native-video">
              <source src={showreel.videoUrl} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        ) : null}

        <div class="sound-hint">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
          <span>Autoplaying on mute (browser policy). Unmute on the video player anytime for full sound.</span>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .showreel-section {
    padding-top: 2rem;
  }

  .video-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-lg), 0 0 50px -10px rgba(99, 102, 241, 0.25);
  }

  .iframe-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .iframe-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius-md);
  }

  .video-player-container {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .native-video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
  }

  .sound-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
  }

  .sound-hint svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }
</style>

---
import { portfolioData } from '../data/portfolio';

const { personal, socials } = portfolioData;

function parseMetric(value: string) {
  const match = value.trim().match(/^([^\d]*)(\d+)(.*)$/);
  if (!match) return { prefix: '', target: value, suffix: '', display: value };
  return {
    prefix: match[1] || '',
    target: match[2],
    suffix: match[3] || '',
    display: value
  };
}

const heroMetrics = [
  { ...parseMetric(personal.heroStats.activeSubscribers), label: 'Users & OTT Reach' },
  { ...parseMetric(personal.heroStats.renderedObjects), label: 'Rendered Objects' },
  { ...parseMetric(personal.heroStats.workflowSpeedup), label: 'Efficiency Gain' },
  { ...parseMetric(personal.heroStats.proceduralSims), label: 'VR Simulations' }
];
---

<section id="about" class="hero-section">
  <!-- Subtle Gemini Glow in Background -->
  <div class="gemini-ambient-halo" aria-hidden="true"></div>

  <div class="container hero-shell">
    <!-- Top Center Aligned Header Bar: CTA Actions & Social Links -->
    <div class="hero-top-bar">

      <!-- Top Controls: Get In Touch (Left), Connect (Between), Explore Work (Right) -->
      <div class="hero-top-controls">
        <a href="#contact" class="ironman-btn btn-contact" aria-label="Get In Touch">
          <span class="stark-hud-bracket stark-bl" aria-hidden="true"></span>
          <span class="stark-hud-bracket stark-tr" aria-hidden="true"></span>
          <span class="stark-arc-reactor" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2" class="arc-outer-ring" />
              <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.5" class="arc-mid-ring" />
              <polygon points="12 8 15.5 14 8.5 14" fill="currentColor" class="arc-core-triangle" />
            </svg>
          </span>
          <span class="ironman-btn-text">Get In Touch</span>
          <span class="stark-energy-pulse" aria-hidden="true"></span>
        </a>

        <!-- Social Links in Between -->
        <div class="social-links hero-social-between">
          
          <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile" class="social-btn" title="LinkedIn Profile">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href={socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile" class="social-btn" title="GitHub Profile">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a href={socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube Channel" class="social-btn" title="YouTube Channel">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0-.46-5.25 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </a>
          <a href={socials.medium} target="_blank" rel="noopener noreferrer" aria-label="Medium Blog" class="social-btn" title="Medium Blog">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
            </svg>
          </a>
        </div>

        <a href="#projects" class="ironman-btn btn-explore" aria-label="Explore Work">
          <span class="stark-hud-bracket stark-bl" aria-hidden="true"></span>
          <span class="stark-hud-bracket stark-tr" aria-hidden="true"></span>
          <span class="stark-arc-reactor" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2" class="arc-outer-ring" />
              <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.5" class="arc-mid-ring" />
              <polygon points="12 8 15.5 14 8.5 14" fill="currentColor" class="arc-core-triangle" />
            </svg>
          </span>
          <span class="ironman-btn-text">Explore Work</span>
          <span class="stark-energy-pulse" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <!-- Dual Equal-Length Panels: Intro Panel + Profile Spotlight -->
    <div class="hero-container">
      <div class="hero-content hero-panel glass-card">
        <div class="intro-header">
          <h1 class="hero-title">
            <span class="gradient-text">DevPhoton</span>
            <span class="hero-title-sep"> | </span>
            <span class="hero-title-role">XR Unity Developer</span>
          </h1>
          <p class="hero-role">{personal.subheadline}</p>
        </div>

        <!-- Subheadline / Bio -->
        <div class="hero-bio">
          {personal.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="intro-footer-badges">
          <span class="intro-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{personal.yearsOfExperience} Enterprise Experience</span>
          </span>
          <span class="intro-badge-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>{personal.completedProjects} Targets</span>
          </span>
        </div>
      </div>

      <!-- Gemini Profile Showcase Card -->
      <div class="hero-visual">
        <div class="gemini-card-wrapper glass-card">
          <div class="gemini-showcase-content">
            <div class="profile-spotlight-cover">
              <!-- Background Cover Image Layer: Gaurav's photo positioned with face visible on right -->
              <picture class="spotlight-cover-media">
                <source srcset="/images/profile.webp" type="image/webp" />
                <img
                  src={personal.avatar || "/images/profile.jpg"}
                  alt={personal.name}
                  class="spotlight-cover-img"
                  width="600"
                  height="800"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>

              <!-- Directional scrim gradient overlay -->
              <div class="spotlight-scrim"></div>

              <!-- Content shifted to left side where empty bokeh space is -->
              <div class="spotlight-content">
                <div class="spotlight-tag">
                  <span class="sparkle-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                      <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z"/>
                    </svg>
                  </span>
                  <span>Spatial Computing &amp; AI</span>
                </div>

                <h3 class="profile-name">{personal.name}</h3>
                <p class="profile-role">{personal.headline}</p>

                <div class="profile-badge-row">
                  <span class="location-badge">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>{personal.location}</span>
                  </span>
                  <span class="online-indicator">
                    <span class="dot-pulse"></span>
                    <span>Active Now</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Feature Metric Highlights with Animated Counters -->
            <div class="gemini-metrics-grid">
              {heroMetrics.map((m) => (
                <div class="gemini-metric-box">
                  <span
                    class="metric-num gradient-text hero-count"
                    data-target={m.target}
                    data-prefix={m.prefix}
                    data-suffix={m.suffix}
                  >
                    {m.display}
                  </span>
                  <span class="metric-desc">{m.label}</span>
                </div>
              ))}
            </div>

            <!-- Tech stack tags -->
            <div class="gemini-chips-footer">
              <span class="tech-chip">Unity 3D</span>
              <span class="tech-chip">Meta Quest 3</span>
              <span class="tech-chip">WebXR</span>
              <span class="tech-chip">C# / .NET</span>
              <span class="tech-chip">Agentic AI</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 1.15rem 0 2rem 0;
    position: relative;
    overflow: visible;
  }

  .gemini-ambient-halo {
    position: absolute;
    top: -15%;
    right: 5%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.08) 0%, rgba(148, 163, 184, 0.04) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-shell {
    position: relative;
    z-index: 1;
  }

  /* Top Center Aligned Controls Header */
  .hero-top-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 1.15rem;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }

  .hero-top-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 1.75rem;
    width: 100%;
  }

  /* ==========================================================================
     STARK INDUSTRIES / IRON MAN ARC REACTOR BUTTON UI
     ========================================================================== */
  .ironman-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.55rem 1.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #e0f7ff;
    background: linear-gradient(135deg, rgba(8, 16, 32, 0.95) 0%, rgba(13, 26, 50, 0.92) 50%, rgba(6, 12, 24, 0.98) 100%);
    border: 1px solid rgba(0, 240, 255, 0.5);
    border-radius: var(--radius-full);
    box-shadow: 
      0 2px 12px rgba(0, 240, 255, 0.18),
      inset 0 0 10px rgba(0, 240, 255, 0.1),
      inset 0 1px 1px rgba(255, 255, 255, 0.25);
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 155px;
    z-index: 1;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .ironman-btn-text {
    position: relative;
    z-index: 2;
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.55);
    transition: text-shadow 0.25s ease;
  }

  /* Arc Reactor Pulsing Core Icon */
  .stark-arc-reactor {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: #00f0ff;
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.85));
    position: relative;
    z-index: 2;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .arc-outer-ring {
    animation: arcSpin 12s linear infinite;
    transform-origin: center;
  }

  .arc-mid-ring {
    animation: arcPulse 2s ease-in-out infinite alternate;
  }

  .arc-core-triangle {
    animation: coreGlow 1.8s ease-in-out infinite alternate;
    transform-origin: center;
  }

  @keyframes arcSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes arcPulse {
    0% { opacity: 0.7; stroke-width: 1.2; }
    100% { opacity: 1; stroke-width: 1.8; }
  }

  @keyframes coreGlow {
    0% { transform: scale(0.92); opacity: 0.85; }
    100% { transform: scale(1.08); opacity: 1; }
  }

  /* HUD Cyber Brackets */
  .stark-hud-bracket {
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
    opacity: 0.7;
    transition: all 0.25s ease;
  }

  .stark-bl {
    bottom: 5px;
    left: 9px;
    border-bottom: 2px solid #00f0ff;
    border-left: 2px solid #00f0ff;
    border-bottom-left-radius: 4px;
  }

  .stark-tr {
    top: 5px;
    right: 9px;
    border-top: 2px solid #00f0ff;
    border-right: 2px solid #00f0ff;
    border-top-right-radius: 4px;
  }

  /* Sweep Energy Scan */
  .stark-energy-pulse {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.4), transparent);
    transform: skewX(-25deg);
    pointer-events: none;
    transition: left 0.65s ease;
  }

  /* Hover State (Arc Overcharge / Repulsor Activation) */
  .ironman-btn:hover {
    border-color: rgba(0, 240, 255, 0.7);
    color: #ffffff;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 
      0 4px 20px rgba(0, 240, 255, 0.32),
      inset 0 0 12px rgba(0, 240, 255, 0.2),
      inset 0 1px 2px rgba(255, 255, 255, 0.4);
  }

  .ironman-btn:hover .ironman-btn-text {
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
  }

  .ironman-btn:hover .stark-arc-reactor {
    transform: scale(1.15) rotate(45deg);
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.6));
  }

  .ironman-btn:hover .stark-energy-pulse {
    left: 150%;
  }

  .ironman-btn:hover .stark-bl,
  .ironman-btn:hover .stark-tr {
    opacity: 1;
    transform: scale(1.25);
    filter: drop-shadow(0 0 4px rgba(0, 240, 255, 0.6));
  }

  /* Active / Click effect (Repulsor Blast) */
  .ironman-btn:active {
    transform: translateY(0) scale(0.98);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.5), inset 0 0 15px rgba(0, 240, 255, 0.4);
  }

  .hero-top-controls .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0 1.5rem;
    border-left: 1px solid rgba(0, 240, 255, 0.25);
    border-right: 1px solid rgba(0, 240, 255, 0.25);
    border-top: none;
  }

  @media (max-width: 768px) {
    .hero-top-controls {
      flex-direction: column;
      gap: 0.9rem;
    }
    .hero-top-controls .social-links {
      border-left: none;
      border-right: none;
      padding: 0.35rem 0;
      order: 2;
    }
    .btn-contact {
      order: 1;
      width: 100%;
      max-width: 280px;
    }
    .btn-explore {
      order: 3;
      width: 100%;
      max-width: 280px;
    }
  }

  /* Dual Equal-Length Panels */
  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: stretch;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    background: var(--bg-card-plasma, var(--bg-card));
    background-clip: padding-box;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(56, 189, 248, 0.36);
    border-radius: var(--radius-lg);
    padding: 1.65rem 1.85rem;
    box-shadow: var(--panel-border-glow);
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-content:hover {
    border-color: rgba(56, 189, 248, 0.56);
    box-shadow: var(--panel-border-glow-hover);
  }

  :global([data-theme="dark"]) .hero-content {
    border-color: rgba(56, 189, 248, 0.38);
    box-shadow: var(--panel-border-glow);
  }

  :global([data-theme="dark"]) .hero-content:hover {
    border-color: rgba(56, 189, 248, 0.58);
    box-shadow: var(--panel-border-glow-hover);
  }

  .hero-content > * {
    position: relative;
    z-index: 1;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(15, 157, 88, 0.6); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(15, 157, 88, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(15, 157, 88, 0); }
  }

  .hero-title {
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.22;
    margin-bottom: 0.45rem;
  }

  .hero-title-sep {
    opacity: 0.35;
    font-weight: 300;
    margin: 0 0.15rem;
  }

  .hero-title-role {
    font-weight: 700;
  }

  .hero-role {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.85rem;
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 0.85rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
    flex: 1;
  }

  .intro-footer-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.15rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .intro-badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--text-secondary);
  }

  .intro-badge-item svg {
    color: var(--accent-blue);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    color: #ffffff;
    background: var(--gradient-brand);
    border-color: transparent;
    transform: translateY(-3px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .social-btn:hover {
    color: #09090b;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.15);
  }

  /* Gemini Profile Showcase Card */
  .hero-visual {
    height: 100%;
  }

  .gemini-card-wrapper {
    background: var(--bg-card-plasma, var(--bg-card));
    background-clip: padding-box;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(56, 189, 248, 0.36);
    border-radius: var(--radius-lg);
    box-shadow: var(--panel-border-glow);
    overflow: hidden;
    position: relative;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .gemini-card-wrapper:hover {
    border-color: rgba(56, 189, 248, 0.56);
    box-shadow: var(--panel-border-glow-hover);
  }

  :global([data-theme="dark"]) .gemini-card-wrapper {
    border-color: rgba(56, 189, 248, 0.38);
    box-shadow: var(--panel-border-glow);
  }

  :global([data-theme="dark"]) .gemini-card-wrapper:hover {
    border-color: rgba(56, 189, 248, 0.58);
    box-shadow: var(--panel-border-glow-hover);
  }

  .gemini-showcase-content {
    position: relative;
    z-index: 1;
    padding: 1.45rem 1.55rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
  }

  /* Profile Spotlight Cover Banner (Faded Cosmic Orange Glow by default) */
  .profile-spotlight-cover {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 0.75rem;
    min-height: 195px;
    border: 1px solid rgba(251, 146, 60, 0.34);
    background: var(--bg-secondary);
    box-shadow:
      0 0 18px -2px rgba(249, 115, 22, 0.2),
      0 0 38px -6px rgba(251, 146, 60, 0.16),
      0 8px 24px -4px rgba(0, 0, 0, 0.08),
      inset 0 0 24px -6px rgba(251, 146, 60, 0.14);
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .profile-spotlight-cover:hover {

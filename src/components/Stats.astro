---
import { portfolioData } from '../data/portfolio';

const { statHighlights } = portfolioData;
// Map the 6 metrics for the Bento layout
const heroMetric = statHighlights.find((s) => s.id === 'stat-subscribers') || statHighlights[0];
const gridMetrics = statHighlights.filter((s) => s.id !== heroMetric.id);
---

<div class="stats-bento-container">
  <!-- Executive Bento Metrics Grid -->
  <div class="bento-grid">
      <!-- 1. Featured Hero Bento Card (Spans 2 Columns) -->
      <article class="bento-card bento-hero glass-card">
        <div class="bento-glow-ambient" aria-hidden="true"></div>
        <div class="bento-card-content">
          <div class="bento-badge-row">
            <span class="bento-pill pill-blue">Scale & High Availability</span>
            <span class="bento-market-tag">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
              </svg>
              <span>22 European Markets</span>
            </span>
          </div>

          <div class="bento-metric-large">
            <span
              class="bento-num gradient-text bento-counter"
              data-raw={heroMetric.rawNumber}
              data-prefix={heroMetric.prefix || ''}
              data-suffix={heroMetric.suffix}
            >
              {heroMetric.targetValue}
            </span>
            <span class="bento-metric-title">{heroMetric.title}</span>
          </div>

          <p class="bento-desc">
            {heroMetric.context}
          </p>

          <div class="bento-chips">
            <span class="chip">AWS Cloud Infrastructure</span>
            <span class="chip">Java & Spring Boot</span>
            <span class="chip">CI/CD Automation</span>
            <span class="chip">Incident Management</span>
          </div>
        </div>
      </article>

      <!-- 2. Real-Time Rendered Objects -->
      {gridMetrics[0] && (
        <article class="bento-card glass-card">
          <div class="bento-card-content">
            <div class="bento-badge-row">
              <span class="bento-pill pill-purple">Graphics & 3D</span>
            </div>
            <div class="bento-metric-medium">
              <span
                class="bento-num gradient-text bento-counter"
                data-raw={gridMetrics[0].rawNumber}
                data-prefix={gridMetrics[0].prefix || ''}
                data-suffix={gridMetrics[0].suffix}
              >
                {gridMetrics[0].targetValue}
              </span>
              <span class="bento-metric-title">{gridMetrics[0].title}</span>
            </div>
            <p class="bento-desc">{gridMetrics[0].context}</p>
            <div class="bento-chips">
              <span class="chip">GPU Instancing</span>
              <span class="chip">Spatial Partitioning</span>
              <span class="chip">Dynamic Streaming</span>
            </div>
          </div>
        </article>
      )}

      <!-- 3. Workflow Efficiency (+300%) -->
      {gridMetrics[1] && (
        <article class="bento-card glass-card">
          <div class="bento-card-content">
            <div class="bento-badge-row">
              <span class="bento-pill pill-emerald">Productivity & CI</span>
            </div>
            <div class="bento-metric-medium">
              <span
                class="bento-num gradient-text bento-counter"
                data-raw={gridMetrics[1].rawNumber}
                data-prefix={gridMetrics[1].prefix || ''}
                data-suffix={gridMetrics[1].suffix}
              >
                {gridMetrics[1].targetValue}
              </span>
              <span class="bento-metric-title">{gridMetrics[1].title}</span>
            </div>
            <p class="bento-desc">{gridMetrics[1].context}</p>
            <div class="bento-chips">
              <span class="chip">Unity Editor Tools</span>
              <span class="chip">Reference Automation</span>
            </div>
          </div>
        </article>
      )}

      <!-- 4. Procedural Simulations (29+) -->
      {gridMetrics[2] && (
        <article class="bento-card glass-card">
          <div class="bento-card-content">
            <div class="bento-badge-row">
              <span class="bento-pill pill-cyan">XR State Architecture</span>
            </div>
            <div class="bento-metric-medium">
              <span
                class="bento-num gradient-text bento-counter"
                data-raw={gridMetrics[2].rawNumber}
                data-prefix={gridMetrics[2].prefix || ''}
                data-suffix={gridMetrics[2].suffix}
              >
                {gridMetrics[2].targetValue}
              </span>
              <span class="bento-metric-title">{gridMetrics[2].title}</span>
            </div>
            <p class="bento-desc">{gridMetrics[2].context}</p>
            <div class="bento-chips">
              <span class="chip">Meta Quest 3</span>
              <span class="chip">6DoF Interaction</span>
            </div>
          </div>
        </article>
      )}

      <!-- 5. Enterprise VR Modules (16+) -->
      {gridMetrics[3] && (
        <article class="bento-card glass-card">
          <div class="bento-card-content">
            <div class="bento-badge-row">
              <span class="bento-pill pill-indigo">Modular Frameworks</span>
            </div>
            <div class="bento-metric-medium">
              <span
                class="bento-num gradient-text bento-counter"
                data-raw={gridMetrics[3].rawNumber}
                data-prefix={gridMetrics[3].prefix || ''}
                data-suffix={gridMetrics[3].suffix}
              >
                {gridMetrics[3].targetValue}
              </span>
              <span class="bento-metric-title">{gridMetrics[3].title}</span>
            </div>
            <p class="bento-desc">{gridMetrics[3].context}</p>
            <div class="bento-chips">
              <span class="chip">Feast Software</span>
              <span class="chip">Vector Troubleshooting</span>
            </div>
          </div>
        </article>
      )}

      <!-- 6. Industry Experience (5 Years) -->
      {gridMetrics[4] && (
        <article class="bento-card glass-card">
          <div class="bento-card-content">
            <div class="bento-badge-row">
              <span class="bento-pill pill-rose">Proven Tenure</span>
            </div>
            <div class="bento-metric-medium">
              <span
                class="bento-num gradient-text bento-counter"
                data-raw={gridMetrics[4].rawNumber}
                data-prefix={gridMetrics[4].prefix || ''}
                data-suffix={gridMetrics[4].suffix}
              >
                {gridMetrics[4].targetValue}
              </span>
              <span class="bento-metric-title">{gridMetrics[4].title}</span>
            </div>
            <p class="bento-desc">{gridMetrics[4].context}</p>
            <div class="bento-chips">
              <span class="chip">5 Tech Firms</span>
              <span class="chip">Full Lifecycle</span>
            </div>
          </div>
        </article>
      )}
    </div>
  </div>

<style>
  .stats-bento-container {
    padding: 0.5rem 0 1.25rem 0;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
    margin-top: 0.25rem;
  }

  .bento-card {
    padding: 1.6rem 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-focus);
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }

  /* Span 2 cols for Hero Highlight Card */
  .bento-hero {
    grid-column: span 2;
  }

  .bento-glow-ambient {
    position: absolute;
    top: -30%;
    right: -20%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(26, 115, 232, 0.12) 0%, rgba(155, 114, 203, 0.08) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    filter: blur(20px);
  }

  .bento-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .bento-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .bento-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .pill-blue {
    background: rgba(26, 115, 232, 0.08);
    color: var(--accent-blue);
    border: 1px solid rgba(26, 115, 232, 0.22);
  }

  .pill-purple {
    background: rgba(124, 58, 237, 0.08);
    color: var(--accent-purple);
    border: 1px solid rgba(124, 58, 237, 0.22);
  }

  .pill-emerald {
    background: rgba(15, 157, 88, 0.08);
    color: var(--accent-emerald);
    border: 1px solid rgba(15, 157, 88, 0.22);
  }

  .pill-cyan {
    background: rgba(2, 132, 199, 0.08);
    color: var(--accent-cyan);
    border: 1px solid rgba(2, 132, 199, 0.22);
  }

  .pill-indigo {
    background: rgba(66, 133, 244, 0.08);
    color: var(--accent-indigo);
    border: 1px solid rgba(66, 133, 244, 0.22);
  }

  .pill-rose {
    background: rgba(217, 101, 112, 0.08);
    color: var(--accent-rose);
    border: 1px solid rgba(217, 101, 112, 0.22);
  }

  .bento-market-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Metric Number Typography */
  .bento-metric-large {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .bento-metric-large .bento-num {
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .bento-metric-medium {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 0.45rem;
    flex-wrap: wrap;
  }

  .bento-metric-medium .bento-num {
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .bento-metric-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .bento-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.15rem;
    flex-grow: 1;
  }

  .bento-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 960px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .bento-hero {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }

    .bento-hero {
      grid-column: span 1;
    }

    .bento-card {
      padding: 1.35rem 1.25rem;
    }
  }
</style>

<script>
  // Animated Counters for Bento Metrics
  const counters = document.querySelectorAll<HTMLElement>('.bento-counter');

  if (counters.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          counters.forEach((el) => {
            const raw = parseInt(el.dataset.raw || '0', 10);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const duration = 1200;
            const startTime = performance.now();

            const tick = (now: number) => {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const ease = 1 - Math.pow(1 - progress, 3);
              const val = Math.floor(ease * raw);
              el.textContent = `${prefix}${val}${suffix}`;
              if (progress < 1) {
                requestAnimationFrame(tick);
              } else {
                el.textContent = `${prefix}${raw}${suffix}`;
              }
            };
            requestAnimationFrame(tick);
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.15 });

    const firstCard = document.querySelector('.bento-card');
    if (firstCard) observer.observe(firstCard);
  }
</script>

---
import { portfolioData } from '../data/portfolio';

const { platformMatrix } = portfolioData;
const filterOptions = [
  { label: 'All Targets', value: 'All' },
  { label: 'Virtual Reality & XR', value: 'XR' },
  { label: 'Mobile & Touch', value: 'Mobile' },
  { label: 'Desktop & Web', value: 'DesktopWeb' }
];
---

<div class="platform-matrix-wrapper">
  <!-- Platform Filter Tabs -->
  <div class="platform-filter-bar" role="tablist" aria-label="Platform category filter">
        {filterOptions.map((opt, idx) => (
          <button
            class={`platform-filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={opt.value}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
          >
            {opt.label}
          </button>
        ))}
      </div>

    <!-- Platform Grid -->
    <div class="platform-grid" id="platform-grid">
      {platformMatrix.map((item) => (
        <article
          class="platform-card glass-card"
          data-cat={item.category}
          tabindex="0"
          role="region"
          aria-label={`${item.platform} deployment`}
        >
          <div class="card-header-row">
            <div class="platform-info">
              <span class="platform-icon" aria-hidden="true">{item.icon}</span>
              <div>
                <h3 class="platform-title">{item.platform}</h3>
                <span class="platform-cat-tag">{item.category} Target</span>
              </div>
            </div>
            <span class={`status-badge status-${item.badgeType}`}>
              {item.shippedStatus}
            </span>
          </div>

          <div class="platform-scale-metric">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>{item.scaleMetric}</span>
          </div>

          <p class="platform-execution-desc">
            {item.executionDetails}
          </p>

          <div class="card-footer-indicator">
            <div class="indicator-dot"></div>
            <span class="indicator-text">Shipped & Verified</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Multi-Platform Capability Callout -->
    <div class="platform-summary-strip glass-card">
      <div class="strip-item">
        <span class="strip-num gradient-text">9</span>
        <span class="strip-label">Platform Targets</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-num gradient-text">10M+</span>
        <span class="strip-label">Total User Reach</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-num gradient-text">90 FPS</span>
        <span class="strip-label">Fixed Standalone VR</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-num gradient-text">0-Install</span>
        <span class="strip-label">WebXR Browser Engine</span>
      </div>
    </div>
  </div>

<style>
  .platform-matrix-section {
    padding: 3rem 0 3.5rem 0;
    position: relative;
  }

  .platform-filter-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .platform-filter-btn {
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .platform-filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
    transform: translateY(-1px);
  }

  .platform-filter-btn.active {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
    box-shadow: 0 4px 14px rgba(26, 115, 232, 0.28);
  }

  [data-theme="dark"] .platform-filter-btn.active {
    background: var(--accent-blue);
    color: #131314;
    box-shadow: 0 4px 16px rgba(138, 180, 248, 0.32);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
    margin-top: 1.75rem;
  }

  .platform-card {
    padding: 1.35rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  .platform-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
    border-color: var(--border-glow);
  }

  .platform-card.hidden {
    display: none;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.15rem;
    gap: 0.5rem;
  }

  .platform-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .platform-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .platform-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .platform-cat-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-success {
    background: rgba(15, 157, 88, 0.1);
    color: var(--accent-emerald);
    border: 1px solid rgba(15, 157, 88, 0.25);
  }

  .status-primary {
    background: rgba(26, 115, 232, 0.1);
    color: var(--accent-blue);
    border: 1px solid rgba(26, 115, 232, 0.25);
  }

  .status-info {
    background: rgba(124, 58, 237, 0.1);
    color: var(--accent-purple);
    border: 1px solid rgba(124, 58, 237, 0.25);
  }

  .status-warning {
    background: rgba(217, 101, 112, 0.1);
    color: var(--accent-rose);
    border: 1px solid rgba(217, 101, 112, 0.25);
  }

  .platform-scale-metric {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-blue);
    background: rgba(26, 115, 232, 0.06);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.85rem;
    width: fit-content;
  }

  .platform-execution-desc {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-footer-indicator {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .indicator-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 6px rgba(15, 157, 88, 0.5);
  }

  /* Summary Strip */
  .platform-summary-strip {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 1.75rem 2rem;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    margin-top: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .strip-num {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.2rem;
  }

  .strip-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .strip-divider {
    width: 1px;
    height: 36px;
    background: var(--border-subtle);
  }

  @media (max-width: 980px) {
    .platform-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .platform-grid {
      grid-template-columns: 1fr;
    }

    .platform-summary-strip {
      flex-direction: column;
      gap: 1.25rem;
    }

    .strip-divider {
      display: none;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.platform-filter-btn');
  const platformCards = document.querySelectorAll<HTMLElement>('.platform-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.dataset.filter || 'All';

      platformCards.forEach((card) => {
        const cat = card.dataset.cat || '';
        let match = false;

        if (filter === 'All') {
          match = true;
        } else if (filter === 'XR' && cat === 'XR') {
          match = true;
        } else if (filter === 'Mobile' && cat === 'Mobile') {
          match = true;
        } else if (filter === 'DesktopWeb' && (cat === 'Desktop' || cat === 'Web')) {
          match = true;
        }

        if (match) {
          card.classList.remove('hidden');
          card.style.opacity = '0';
          card.style.transform = 'translateY(6px)';
          setTimeout(() => {
            card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          }, 10);
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

---
import { portfolioData } from '../data/portfolio';

const config = portfolioData.visitorCounter ?? {
  enabled: true,
  key: 'gaurav-deore-portfolio-visits',
  label: 'Site Visits',
  baseCount: 0
};

const key = config.key || 'gaurav-deore-portfolio-visits';
const label = config.label || 'Site Visits';
const baseCount = config.baseCount || 0;
---

{config.enabled && (
  <div class="visitor-counter-wrapper" data-counter-key={key} data-base-count={baseCount} id="visitor-counter-card">
    <div class="visitor-counter-badge" title="Live unique session visitor count">
      <div class="live-dot-container" aria-hidden="true">
        <span class="live-dot-pulse"></span>
        <span class="live-dot"></span>
      </div>

      <svg class="counter-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>

      <span class="counter-label">{label}</span>

      <span class="counter-divider" aria-hidden="true">•</span>

      <span class="counter-number" id="visitor-count-display">
        <span class="counter-loading-shimmer">---</span>
      </span>
    </div>
  </div>
)}

<script>
  function initVisitorCounter() {
    const wrapper = document.getElementById('visitor-counter-card');
    const display = document.getElementById('visitor-count-display');
    if (!wrapper || !display) return;

    const counterKey = wrapper.getAttribute('data-counter-key') || 'gaurav-deore-portfolio-visits';
    const baseCount = parseInt(wrapper.getAttribute('data-base-count') || '0', 10);
    const storageKey = `portfolio_visit_cache_${counterKey}`;
    const sessionKey = `portfolio_session_${counterKey}`;

    // Instant initial render from local cache if available
    const cachedCount = localStorage.getItem(storageKey);
    if (cachedCount) {
      display.textContent = Number(cachedCount).toLocaleString();
    }

    const hasVisitedThisSession = sessionStorage.getItem(sessionKey);
    const endpoint = hasVisitedThisSession
      ? `https://countapi.mileshilliard.com/api/v1/get/${encodeURIComponent(counterKey)}`
      : `https://countapi.mileshilliard.com/api/v1/hit/${encodeURIComponent(counterKey)}`;

    // Abort controller with 5 second timeout to handle slow networks gracefully
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 5000);

    fetch(endpoint, {
      method: 'GET',
      signal: controller.signal,
      headers: {
        'Accept': 'application/json'
      }
    })
      .then(async (response) => {
        clearTimeout(timeoutId);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then((data) => {
        if (!hasVisitedThisSession) {
          sessionStorage.setItem(sessionKey, '1');
        }

        const rawValue = typeof data.value === 'number' ? data.value : parseInt(data.value, 10);
        const totalVisits = (isNaN(rawValue) ? 1 : rawValue) + baseCount;

        // Persist to local cache for subsequent instant loads & fallback
        localStorage.setItem(storageKey, totalVisits.toString());

        animateCount(display, cachedCount ? parseInt(cachedCount, 10) : 0, totalVisits);
      })
      .catch((err) => {
        clearTimeout(timeoutId);
        // Fallback: If network failed or blocked by adblocker, keep cached value or fallback baseline
        if (!cachedCount) {
          const fallback = Math.max(1, baseCount + 1);
          localStorage.setItem(storageKey, fallback.toString());
          display.textContent = fallback.toLocaleString();
        }
      });
  }

  function animateCount(element: HTMLElement, start: number, target: number) {
    if (start === target) {
      element.textContent = target.toLocaleString();
      return;
    }

    const duration = 1200; // ms
    const startTime = performance.now();
    const initial = Math.max(0, start);

    function step(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Ease out cubic
      const easeProgress = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(initial + (target - initial) * easeProgress);

      element.textContent = current.toLocaleString();

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        element.textContent = target.toLocaleString();
      }
    }

    requestAnimationFrame(step);
  }

  // Support both normal load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVisitorCounter);
  } else {
    initVisitorCounter();
  }
  document.addEventListener('astro:page-load', initVisitorCounter);
</script>

<style>
  .visitor-counter-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .visitor-counter-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    font-size: 0.825rem;
    color: var(--text-secondary);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
    user-select: none;
  }

  .visitor-counter-badge:hover {
    border-color: var(--border-focus);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    color: var(--text-primary);
  }

  /* Live Pulse Green Dot */
  .live-dot-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
  }

  .live-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-emerald, #0f9d58);
  }

  .live-dot-pulse {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-emerald, #0f9d58);
    opacity: 0.45;
    animation: live-pulse-anim 2.2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes live-pulse-anim {
    0% {
      transform: scale(0.6);
      opacity: 0.7;
    }
    70% {
      transform: scale(1.6);
      opacity: 0;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .counter-icon {
    color: var(--accent-blue);
    flex-shrink: 0;
  }

  .counter-label {
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .counter-divider {
    color: var(--text-muted);
    opacity: 0.6;
    font-size: 0.7rem;
  }

  .counter-number {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-blue);
    min-width: 2ch;
    display: inline-block;
    letter-spacing: 0.02em;
  }

  .counter-loading-shimmer {
    opacity: 0.5;
    letter-spacing: 0.1em;
  }

  @media (max-width: 600px) {
    .visitor-counter-badge {
      padding: 0.3rem 0.75rem;
      font-size: 0.775rem;
    }
  }
</style>

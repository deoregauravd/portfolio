---
import { portfolioData } from '../data/portfolio';

const { featuredProjects } = portfolioData;
const categories = ['All', 'XR / VR', 'Games', 'Web & Cloud', 'AI'];
---

<div class="projects-wrapper">
  <!-- Category Filter Bar with Expand/Collapse Master Toggle -->
  <div class="filter-controls-wrapper">
    <div class="filter-bar" role="tablist" aria-label="Project filter">
      {categories.map((cat, idx) => (
        <button
          class={`filter-btn ${idx === 0 ? 'active' : ''}`}
          data-filter={cat}
          role="tab"
          aria-selected={idx === 0 ? "true" : "false"}
        >
          {cat}
        </button>
      ))}
    </div>

    <button id="toggle-all-projects-btn" class="toggle-all-projects-btn" type="button" aria-expanded="false">
      <span class="proj-toggle-icon">▸</span>
      <span class="proj-toggle-text">Expand All Projects</span>
    </button>
  </div>

    <!-- Project Grid -->
    <div class="projects-grid" id="projects-grid">
      {featuredProjects.map((project, idx) => (
        <article class="project-card glass-card proj-card" data-category={project.category} data-idx={idx}>
          <!-- Clickable Header: Always visible -->
          <div
            class="card-header-toggle"
            role="button"
            tabindex="0"
            aria-expanded="false"
            aria-controls={`proj-body-${idx}`}
          >
            <div class="card-top">
              <div class="card-top-left">
                <span class="category-tag">{project.category}</span>
                {project.company && (
                  <span class="company-badge" title={`Created at ${project.company}`}>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    <span>{project.company}</span>
                  </span>
                )}
              </div>
              {project.metrics && (
                <span class="metric-tag">{project.metrics}</span>
              )}
            </div>

            <div class="card-title-row">
              <h3 class="project-title">{project.title}</h3>
              <div class="proj-expand-pill">
                <span class="indicator-label">Details</span>
                <svg class="proj-chevron-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>
          </div>

          <!-- Smooth Collapsible Body -->
          <div id={`proj-body-${idx}`} class="proj-collapsible-wrapper">
            <div class="proj-collapsible-inner">
              <p class="project-desc">{project.description}</p>

              <div class="tech-tags">
                {project.tags.map((tag) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>

              <div class="project-links">
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action primary-link"
                  >
                    <span>Live Project / Preview</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                )}

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action"
                    title="View Code on GitHub"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                    <span>Source Code</span>
                  </a>
                )}

                {project.videoUrl && (
                  <a
                    href={project.videoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action video-link"
                    title="Watch Demo Video"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>Demo Video</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

<style>
  .projects-section {
    padding: 3.5rem 0 4.5rem 0;
  }

  .filter-controls-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
    box-shadow: 0 4px 14px rgba(26, 115, 232, 0.28);
  }

  [data-theme="dark"] .filter-btn.active {
    background: var(--accent-blue);
    color: #131314;
    box-shadow: 0 4px 16px rgba(138, 180, 248, 0.32);
  }

  .toggle-all-projects-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    color: var(--accent-blue);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
    margin-left: auto;
  }

  .toggle-all-projects-btn:hover {
    border-color: var(--border-focus);
    background: var(--bg-tertiary);
    transform: translateY(-1px);
  }

  .proj-toggle-icon {
    font-size: 0.85rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: start;
  }

  .project-card {
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    padding: 1.35rem 1.6rem;
  }

  .project-card:hover {
    border-color: var(--border-focus);
  }

  .project-card.expanded {
    border-color: var(--border-focus);
    box-shadow: var(--shadow-md);
  }

  .project-card.hidden {
    display: none;
  }

  /* Card Header */
  .card-header-toggle {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    cursor: pointer;
    user-select: none;
    outline: none;
  }

  .card-header-toggle:focus-visible {
    outline: 2px solid var(--accent-blue);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-top-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-blue);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .company-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .metric-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-emerald);
    background: rgba(15, 157, 88, 0.1);
    border: 1px solid rgba(15, 157, 88, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 1rem;
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
  }

  .proj-expand-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .card-header-toggle:hover .proj-expand-pill {
    color: var(--accent-blue);
    border-color: var(--border-focus);
    background: var(--bg-secondary);
  }

  .proj-chevron-svg {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card.expanded .proj-chevron-svg {
    transform: rotate(180deg);
  }

  .project-card.expanded .proj-expand-pill {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
  }

  /* GPU-Accelerated Smooth Grid Collapsible */
  .proj-collapsible-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, margin-top 0.28s ease, padding-top 0.28s ease;
    opacity: 0;
    margin-top: 0;
    padding-top: 0;
  }

  .project-card.expanded .proj-collapsible-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .proj-collapsible-inner {
    overflow: hidden;
  }

  .project-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.15rem;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .link-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .link-action:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
    background: var(--bg-secondary);
    transform: translateY(-1px);
  }

  .primary-link {
    background: rgba(26, 115, 232, 0.08);
    border-color: rgba(26, 115, 232, 0.25);
    color: var(--accent-blue);
  }

  .primary-link:hover {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
  }

  .video-link {
    color: var(--accent-rose);
  }

  .video-link:hover {
    background: rgba(217, 101, 112, 0.1);
    border-color: var(--accent-rose);
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .filter-controls-wrapper {
      flex-direction: column;
      align-items: flex-start;
    }

    .toggle-all-projects-btn {
      margin-left: 0;
    }
  }
</style>

<script>
  // Project Card Expand / Collapse Logic
  const cardHeaders = document.querySelectorAll<HTMLElement>('.card-header-toggle');
  const toggleAllBtn = document.getElementById('toggle-all-projects-btn');
  let allProjectsExpanded = false;

  cardHeaders.forEach((header) => {
    const card = header.closest('.proj-card');

    header.addEventListener('click', () => {
      if (!card) return;
      const isExpanded = card.classList.contains('expanded');

      if (isExpanded) {
        card.classList.remove('expanded');
        header.setAttribute('aria-expanded', 'false');
      } else {
        card.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      }
    });

    header.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        header.click();
      }
    });
  });

  // Master Expand / Collapse All Projects
  toggleAllBtn?.addEventListener('click', () => {
    allProjectsExpanded = !allProjectsExpanded;
    toggleAllBtn.setAttribute('aria-expanded', String(allProjectsExpanded));

    const icon = toggleAllBtn.querySelector('.proj-toggle-icon');
    const text = toggleAllBtn.querySelector('.proj-toggle-text');

    if (icon && text) {
      if (allProjectsExpanded) {
        icon.textContent = '▾';
        text.textContent = 'Collapse All Projects';
      } else {
        icon.textContent = '▸';
        text.textContent = 'Expand All Projects';
      }
    }

    cardHeaders.forEach((header) => {
      const card = header.closest('.proj-card');
      if (!card) return;

      if (allProjectsExpanded) {
        card.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      } else {
        card.classList.remove('expanded');
        header.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Filter Bar Functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.dataset.filter;

      projectCards.forEach((card) => {
        const category = card.dataset.category;
        if (filter === 'All' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

---
import { portfolioData } from '../data/portfolio';

const { featuredProjects } = portfolioData;
const companyProjects = featuredProjects.filter((p) => p.projectType === 'company');
const personalProjects = featuredProjects.filter((p) => p.projectType === 'personal');
const categories = ['All', 'XR / VR', 'Games', 'Web & Cloud', 'AI'];
---

<div class="projects-wrapper">
  <!-- Top Panel Selector Switcher -->
  <div class="panel-switcher-wrapper">
    <div class="panel-switcher" role="tablist" aria-label="Project Panel Selector">
      <button
        class="panel-tab-btn active"
        data-panel="all"
        role="tab"
        aria-selected="true"
      >
        <span class="tab-icon">⚡</span>
        <span class="tab-text">All Projects</span>
        <span class="tab-badge">{featuredProjects.length}</span>
      </button>

      <button
        class="panel-tab-btn"
        data-panel="company"
        role="tab"
        aria-selected="false"
      >
        <span class="tab-icon">🏢</span>
        <span class="tab-text">Company Projects</span>
        <span class="tab-badge">{companyProjects.length}</span>
      </button>

      <button
        class="panel-tab-btn"
        data-panel="personal"
        role="tab"
        aria-selected="false"
      >
        <span class="tab-icon">🚀</span>
        <span class="tab-text">Personal Projects</span>
        <span class="tab-badge">{personalProjects.length}</span>
      </button>
    </div>
  </div>

  <!-- Category Filter Bar with Expand/Collapse Master Toggle -->
  <div class="filter-controls-wrapper">
    <div class="filter-bar" role="tablist" aria-label="Project category filter">
      {categories.map((cat, idx) => (
        <button
          class={`filter-btn ${idx === 0 ? 'active' : ''}`}
          data-filter={cat}
          role="tab"
          aria-selected={idx === 0 ? "true" : "false"}
        >
          {cat}
        </button>
      ))}
    </div>

    <button id="toggle-all-projects-btn" class="toggle-all-projects-btn" type="button" aria-expanded="false">
      <span class="proj-toggle-icon">▸</span>
      <span class="proj-toggle-text">Expand All Projects</span>
    </button>
  </div>

  <!-- PANEL 1: Personal Projects Panel -->
  <section class="project-panel" id="panel-personal" data-panel-type="personal">
    <div class="panel-banner personal-banner">
      <div class="panel-banner-left">
        <div class="panel-icon-pill personal-pill">🚀</div>
        <div>
          <h3 class="panel-title">Personal Projects &amp; Products</h3>
          <p class="panel-desc">Independently designed, developed, and published proprietary desktop &amp; mobile apps on Microsoft Store &amp; Google Play, plus AI R&amp;D.</p>
        </div>
      </div>
      <span class="panel-count-badge personal-badge">{personalProjects.length} Published Works</span>
    </div>

    <div class="projects-grid">
      {personalProjects.map((project) => (
        <article
          class="project-card glass-card proj-card"
          data-category={project.category}
          data-project-type="personal"
          id={`proj-card-${project.id}`}
        >
          <!-- Clickable Header: Always visible -->
          <div
            class="card-header-toggle"
            role="button"
            tabindex="0"
            aria-expanded="false"
            aria-controls={`proj-body-${project.id}`}
          >
            <div class="card-top">
              <div class="card-top-left">
                <span class="category-tag">{project.category}</span>
                {project.company && (
                  <span class="company-badge" title={`Created at ${project.company}`}>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    <span>{project.company}</span>
                  </span>
                )}
              </div>
              {project.metrics && (
                <span class="metric-tag">{project.metrics}</span>
              )}
            </div>

            <div class="card-title-row">
              <h3 class="project-title">{project.title}</h3>
              <div class="proj-expand-pill">
                <span class="indicator-label">Details</span>
                <svg class="proj-chevron-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>
          </div>

          <!-- Smooth Collapsible Body -->
          <div id={`proj-body-${project.id}`} class="proj-collapsible-wrapper">
            <div class="proj-collapsible-inner">
              <p class="project-desc">{project.description}</p>

              <div class="tech-tags">
                {project.tags.map((tag) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>

              <div class="project-links">
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action primary-link"
                  >
                    {project.link.includes('apps.microsoft.com') ? (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z"/>
                      </svg>
                    ) : project.link.includes('play.google.com') ? (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3.6 1.8c-.3.3-.5.8-.5 1.5v17.4c0 .7.2 1.2.5 1.5l.1.1 9.8-9.8v-.2L3.7 1.7l-.1.1zM17.3 15.8l-3.2-3.2 3.2-3.2.1.1 3.8 2.2c1.1.6 1.1 1.6 0 2.2l-3.9 1.9zM13.4 12.1L3.9 2.6c.4-.4 1.1-.4 2-.1l10.9 6.2-3.4 3.4zM13.4 12.5l3.4 3.4-10.9 6.2c-.9.5-1.6.3-2-.1l9.5-9.5z"/>
                      </svg>
                    ) : (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    )}
                    <span>
                      {project.linkLabel || (
                        project.link.includes('apps.microsoft.com') ? 'Microsoft Store' :
                        project.link.includes('play.google.com') ? 'Google Play Store' :
                        project.link.includes('apps.apple.com') ? 'App Store' :
                        'Live Project / Preview'
                      )}
                    </span>
                  </a>
                )}

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action"
                    title="View Code on GitHub"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                    <span>Source Code</span>
                  </a>
                )}

                {project.videoUrl && (
                  <a
                    href={project.videoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action video-link"
                    title="Watch Demo Video"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>Demo Video</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- PANEL 2: Company Projects Panel -->
  <section class="project-panel" id="panel-company" data-panel-type="company">
    <div class="panel-banner company-banner">
      <div class="panel-banner-left">
        <div class="panel-icon-pill company-pill">🏢</div>
        <div>
          <h3 class="panel-title">Company &amp; Enterprise Projects</h3>
          <p class="panel-desc">Pan-European streaming OTT systems, Meta Quest 3 VR simulations, and mobile games engineered across 5 industry firms.</p>
        </div>
      </div>
      <span class="panel-count-badge company-badge-pill">{companyProjects.length} Commercial Works</span>
    </div>

    <div class="projects-grid">
      {companyProjects.map((project) => (
        <article
          class="project-card glass-card proj-card"
          data-category={project.category}
          data-project-type="company"
          id={`proj-card-${project.id}`}
        >
          <!-- Clickable Header: Always visible -->
          <div
            class="card-header-toggle"
            role="button"
            tabindex="0"
            aria-expanded="false"
            aria-controls={`proj-body-${project.id}`}
          >
            <div class="card-top">
              <div class="card-top-left">
                <span class="category-tag">{project.category}</span>
                {project.company && (
                  <span class="company-badge" title={`Created at ${project.company}`}>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    <span>{project.company}</span>
                  </span>
                )}
              </div>
              {project.metrics && (
                <span class="metric-tag">{project.metrics}</span>
              )}
            </div>

            <div class="card-title-row">
              <h3 class="project-title">{project.title}</h3>
              <div class="proj-expand-pill">
                <span class="indicator-label">Details</span>
                <svg class="proj-chevron-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>
          </div>

          <!-- Smooth Collapsible Body -->
          <div id={`proj-body-${project.id}`} class="proj-collapsible-wrapper">
            <div class="proj-collapsible-inner">
              <p class="project-desc">{project.description}</p>

              <div class="tech-tags">
                {project.tags.map((tag) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>

              <div class="project-links">
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action primary-link"
                  >
                    {project.link.includes('apps.microsoft.com') ? (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z"/>
                      </svg>
                    ) : project.link.includes('play.google.com') ? (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3.6 1.8c-.3.3-.5.8-.5 1.5v17.4c0 .7.2 1.2.5 1.5l.1.1 9.8-9.8v-.2L3.7 1.7l-.1.1zM17.3 15.8l-3.2-3.2 3.2-3.2.1.1 3.8 2.2c1.1.6 1.1 1.6 0 2.2l-3.9 1.9zM13.4 12.1L3.9 2.6c.4-.4 1.1-.4 2-.1l10.9 6.2-3.4 3.4zM13.4 12.5l3.4 3.4-10.9 6.2c-.9.5-1.6.3-2-.1l9.5-9.5z"/>
                      </svg>
                    ) : (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    )}
                    <span>
                      {project.linkLabel || (
                        project.link.includes('apps.microsoft.com') ? 'Microsoft Store' :
                        project.link.includes('play.google.com') ? 'Google Play Store' :
                        project.link.includes('apps.apple.com') ? 'App Store' :
                        'Live Project / Preview'
                      )}
                    </span>
                  </a>
                )}

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action"
                    title="View Code on GitHub"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                    <span>Source Code</span>
                  </a>
                )}

                {project.videoUrl && (
                  <a
                    href={project.videoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-action video-link"
                    title="Watch Demo Video"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>Demo Video</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  .projects-wrapper {
    width: 100%;
  }

  /* Panel Switcher Tabs */
  .panel-switcher-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .panel-switcher {
    display: inline-flex;
    background: var(--bg-surface-elevated, rgba(17, 24, 39, 0.7));
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-lg, 14px);
    padding: 0.35rem;
    gap: 0.4rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
    flex-wrap: wrap;
    justify-content: center;
  }

  .panel-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-md, 10px);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-secondary, #94a3b8);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .panel-tab-btn:hover {
    color: var(--text-primary, #ffffff);
    background: rgba(255, 255, 255, 0.05);
  }

  .panel-tab-btn.active {
    background: var(--bg-surface, #1e293b);
    color: #ffffff;
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow: 0 2px 12px rgba(99, 102, 241, 0.28);
  }

  .panel-tab-btn .tab-badge {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary, #f1f5f9);
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
  }

  .panel-tab-btn.active .tab-badge {
    background: rgba(99, 102, 241, 0.3);
    color: #a5b4fc;
  }

  /* Filter Controls */
  .filter-controls-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.45rem 1.05rem;
    border-radius: 9999px;
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    background: var(--bg-surface-elevated, rgba(15, 23, 42, 0.6));
    color: var(--text-secondary, #94a3b8);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    color: var(--text-primary, #ffffff);
    border-color: var(--border-default, rgba(255, 255, 255, 0.15));
    background: rgba(255, 255, 255, 0.04);
  }

  .filter-btn.active {
    background: var(--accent-gradient, linear-gradient(135deg, #6366f1, #3b82f6));
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
  }

  .toggle-all-projects-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.95rem;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    background: var(--bg-surface-elevated, rgba(15, 23, 42, 0.6));
    color: var(--text-secondary, #94a3b8);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-left: auto;
  }

  .toggle-all-projects-btn:hover {
    color: var(--text-primary, #ffffff);
    border-color: var(--accent-blue, #60a5fa);
  }

  .proj-toggle-icon {
    font-size: 0.85rem;
    transition: transform 0.2s ease;
  }

  /* Panels */
  .project-panel {
    margin-bottom: 2.75rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .project-panel.panel-hidden {
    display: none;
  }

  .panel-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius-md, 10px);
    margin-bottom: 1.35rem;
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    background: var(--bg-surface-elevated, rgba(15, 23, 42, 0.6));
    backdrop-filter: blur(12px);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .personal-banner {
    border-left: 4px solid #10b981;
    background: linear-gradient(90deg, rgba(16, 185, 129, 0.09) 0%, rgba(15, 23, 42, 0.6) 100%);
  }

  .company-banner {
    border-left: 4px solid #3b82f6;
    background: linear-gradient(90deg, rgba(59, 130, 246, 0.09) 0%, rgba(15, 23, 42, 0.6) 100%);
  }

  .panel-banner-left {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .panel-icon-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .personal-pill {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .company-pill {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .panel-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .panel-desc {
    font-size: 0.82rem;
    color: var(--text-secondary, #94a3b8);
    margin: 0.25rem 0 0 0;
  }

  .panel-count-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.8rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .personal-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .company-badge-pill {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.35);
  }

  /* Project Grid & Cards */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 1.15rem 1.35rem;
    border-radius: var(--radius-md, 10px);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 8px 24px rgba(0, 0, 0, 0.3));
    border-color: rgba(99, 102, 241, 0.3);
  }

  .project-card.hidden {
    display: none !important;
  }

  /* Card Header Toggle */
  .card-header-toggle {
    cursor: pointer;
    outline: none;
    user-select: none;
  }

  .card-header-toggle:focus-visible {
    border-radius: var(--radius-sm, 6px);
    outline: 2px solid var(--accent-blue, #3b82f6);
    outline-offset: 3px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .card-top-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-cyan, #06b6d4);
  }

  .company-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: 9999px;
    color: var(--text-secondary, #94a3b8);
  }

  .metric-tag {
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--accent-emerald, #10b981);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    margin: 0;
    line-height: 1.35;
  }

  .proj-expand-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary, #94a3b8);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .card-header-toggle:hover .proj-expand-pill {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.4);
    color: #a5b4fc;
  }

  .proj-chevron-svg {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proj-card.expanded .proj-chevron-svg {
    transform: rotate(180deg);
  }

  .proj-card.expanded .proj-expand-pill {
    background: rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.5);
    color: #ffffff;
  }

  /* Collapsible Wrapper */
  .proj-collapsible-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proj-card.expanded .proj-collapsible-wrapper {
    grid-template-rows: 1fr;
  }

  .proj-collapsible-inner {
    overflow: hidden;
  }

  .project-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary, #94a3b8);
    margin: 0.85rem 0 0.85rem 0;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.95rem;
  }

  .badge {
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-sm, 4px);
    color: var(--text-secondary, #94a3b8);
  }

  /* Project Action Links */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .link-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
    background: var(--bg-surface-elevated, rgba(15, 23, 42, 0.6));
    color: var(--text-primary, #ffffff);
  }

  .link-action:hover {
    transform: translateY(-1px);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .link-action.primary-link {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
  }

  .link-action.primary-link:hover {
    background: rgba(99, 102, 241, 0.25);
    border-color: rgba(99, 102, 241, 0.6);
    color: #ffffff;
  }

  .link-action.video-link {
    background: rgba(244, 63, 94, 0.12);
    border-color: rgba(244, 63, 94, 0.3);
    color: #fda4af;
  }

  .link-action.video-link:hover {
    background: rgba(244, 63, 94, 0.22);
    border-color: rgba(244, 63, 94, 0.6);
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .filter-controls-wrapper {
      flex-direction: column;
      align-items: flex-start;
    }

    .toggle-all-projects-btn {
      margin-left: 0;
    }
  }
</style>

<script>
  // Panel Switcher Logic
  const panelTabs = document.querySelectorAll<HTMLButtonElement>('.panel-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.project-panel');

  panelTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      panelTabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const target = tab.dataset.panel;
      panels.forEach((p) => {
        const type = p.dataset.panelType;
        if (target === 'all' || target === type) {
          p.classList.remove('panel-hidden');
        } else {
          p.classList.add('panel-hidden');
        }
      });
    });
  });

  // Project Card Expand / Collapse Logic
  const cardHeaders = document.querySelectorAll<HTMLElement>('.card-header-toggle');
  const toggleAllBtn = document.getElementById('toggle-all-projects-btn');
  let allProjectsExpanded = false;

  cardHeaders.forEach((header) => {
    const card = header.closest('.proj-card');

    header.addEventListener('click', () => {
      if (!card) return;
      const isExpanded = card.classList.contains('expanded');

      if (isExpanded) {
        card.classList.remove('expanded');
        header.setAttribute('aria-expanded', 'false');
      } else {
        card.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      }
    });

    header.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        header.click();
      }
    });
  });

  // Master Expand / Collapse All Projects
  toggleAllBtn?.addEventListener('click', () => {
    allProjectsExpanded = !allProjectsExpanded;
    toggleAllBtn.setAttribute('aria-expanded', String(allProjectsExpanded));

    const icon = toggleAllBtn.querySelector('.proj-toggle-icon');
    const text = toggleAllBtn.querySelector('.proj-toggle-text');

    if (icon && text) {
      if (allProjectsExpanded) {
        icon.textContent = '▾';
        text.textContent = 'Collapse All Projects';
      } else {
        icon.textContent = '▸';
        text.textContent = 'Expand All Projects';
      }
    }

    cardHeaders.forEach((header) => {
      const card = header.closest('.proj-card');
      if (!card) return;

      if (allProjectsExpanded) {
        card.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      } else {
        card.classList.remove('expanded');
        header.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Filter Bar Functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.dataset.filter;

      projectCards.forEach((card) => {
        const category = card.dataset.category;
        if (filter === 'All' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

---
import { portfolioData } from '../data/portfolio';
import VisitorCounter from './VisitorCounter.astro';

const { personal, socials } = portfolioData;
const currentYear = new Date().getFullYear();
---

<footer class="footer-section">
  <div class="container">
    <div class="footer-panel glass-card">
      <div class="footer-brand">
        <div class="brand-title">{personal.name}</div>
        <p class="brand-sub">{personal.headline}</p>
      </div>

      <div class="footer-links">
        <a href={socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={socials.medium} target="_blank" rel="noopener noreferrer">Medium</a>
        <a href={socials.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
        {socials.resumeGoogleDocs && (
          <a href={socials.resumeGoogleDocs} target="_blank" rel="noopener noreferrer">Resume</a>
        )}
        <a href="https://www.devphoton.com/privacy">Privacy Policy</a>
        <a href="https://www.devphoton.com/support">Support</a>
      </div>

      <div class="footer-bottom">
        <a href="#about" class="back-to-top back-to-top-left" aria-label="Back to top" onclick="event.preventDefault(); window.scrollTo({top: 0, behavior: 'smooth'});">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
          <span>Back to Top</span>
        </a>
        <div class="footer-counter-container">
          <VisitorCounter />
        </div>
        <a href="#about" class="back-to-top back-to-top-right" aria-label="Back to top" onclick="event.preventDefault(); window.scrollTo({top: 0, behavior: 'smooth'});">
          <span>Back to Top</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    padding: 1.5rem 0 3.5rem 0;
    position: relative;
    z-index: 1;
  }

  .footer-panel {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding: 3rem 2.5rem 2.25rem 2.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card-plasma, var(--bg-card));
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .footer-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gradient-brand);
    opacity: 0.85;
  }

  .footer-brand {
    text-align: center;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .brand-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .footer-links a {
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-blue);
  }

  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-muted);
    gap: 1rem;
    box-sizing: border-box;
  }

  .footer-counter-container {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    text-align: center;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    cursor: pointer;
  }

  .back-to-top:hover {
    color: var(--text-primary);
  }

  .back-to-top-left {
    justify-self: start;
    margin-right: auto;
  }

  .back-to-top-right {
    justify-self: end;
    margin-left: auto;
  }

  .footer-privacy-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .footer-privacy-link:hover {
    color: var(--accent-blue);
  }

  .powered-badge {
    color: var(--accent-blue);
    font-weight: 700;
  }

  @media (max-width: 680px) {
    .footer-bottom {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "counter counter"
        "left right";
      gap: 1.25rem;
      width: 100%;
    }

    .footer-counter-container {
      grid-area: counter;
      justify-self: center;
    }

    .back-to-top-left {
      grid-area: left;
      justify-self: start;
      display: inline-flex;
    }

    .back-to-top-right {
      grid-area: right;
      justify-self: end;
      display: inline-flex;
    }
  }
</style>
